    "_postman_id": "df518136-e87f-4b5f-b2a0-eda6ff42206c",
    "name": "Halo Cloud API for Desktop Applications Tokens API",
    "description": "## Introduction\nThis API reference documents the endpoints available for desktop application integration with the Halo Connect Cloud API.\n\nContact Support:\n Email: support@haloconnect.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:18:23.000Z",
